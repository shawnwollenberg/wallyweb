MY_WALLET_ADDRESS=0xYourReceivingWalletHere
PORT=3000

# Keep true while developing locally. Set false in AWS.
X402_DEV_BYPASS=true
# CDP rejects prices below 0.001. This route is $0.005.
X402_RECOMMEND_PRICE_USD=0.005
X402_NETWORK=eip155:8453
# Settlements on this facilitator are what qualify the route for the Bazaar.
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Required for the CDP facilitator. Create them at https://portal.cdp.coinbase.com/
# Secret key, not the wallet secret. Never commit the values.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

ROOT_DOMAIN=wallyweb.com
CUSTOM_DOMAIN=compass.wallyweb.com
PUBLIC_BASE_URL=https://compass.wallyweb.com

# Public Base JSON-RPC used to read USDC transfers to listing payTo addresses.
BASE_RPC_URL=https://mainnet.base.org

# Catalog list is cached for an hour. The public catalog is tens of thousands of rows;
# the refresh walks it until this cap or the time budget.
COMPASS_CATALOG_TTL_SECONDS=3600
COMPASS_CATALOG_MAX_RESOURCES=50000
COMPASS_CATALOG_BUDGET_MS=25000
COMPASS_ACTIVITY_LOOKBACK_BLOCKS=8000
COMPASS_ACTIVITY_ENRICH_LIMIT=12
COMPASS_ACTIVITY_TIMEOUT_MS=8000

# One real settlement. Never commit a private key.
# CONFIRM_X402_PAYMENT=yes npm run settle:once -- --q "wallet portfolio on Base"
X402_TEST_PRIVATE_KEY=
COMPASS_BASE_URL=https://compass.wallyweb.com
